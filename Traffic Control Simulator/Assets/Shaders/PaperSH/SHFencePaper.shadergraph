    "m_SourceType": 1,
    "m_FunctionName": "Light",
    "m_FunctionSource": "",
    "m_FunctionBody": "Light mainLight = GetMainlight ( ) ;\nfloat NdotL = saturate (dot(Normal)) ;\nfloat toon = smoothstep (0.45, 0.5, NdotL) ;\nOut = toon;"
}

